# Environment name: dev, hml or prd
APP_ENV=dev
APP_NAME=gestor-compras-web
APP_VERSION=0.1.0
API_PREFIX=/api
DEBUG=true
# Explicit opt-in for controlled PRD read-only validation. Keep false by default.
GESTOR_PRD_READ_ONLY_VALIDATION=false

# Comma-separated browser origins. Never use * in HML or PRD.
CORS_ORIGINS=http://localhost:5193

# Optional in DEV. Use only environment-specific read-only credentials in the
# local, unversioned .env; PRD additionally requires the explicit opt-in above.
# The named Microsoft ODBC Driver must also be installed in the operating system.
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_CONNECT_TIMEOUT=5
DB_QUERY_TIMEOUT=30
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_APPLICATION_INTENT_READ_ONLY=false
# Controlled physical table suffix used to form names such as SED010 and SE7010.
DB_PROTHEUS_TABLE_SUFFIX=
